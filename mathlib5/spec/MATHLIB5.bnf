(* ============================================================
   MATHLIB5 Surface Syntax — EBNF (ISO/IEC 14977)
   APL → Rust Kernel → C99 FOL → CodeQL → ASP → Prolog → PRISM → P/NP Swarm
   ============================================================ *)

(* ---------- Lexical ---------- *)
IDENTIFIER      = LETTER, { LETTER | DIGIT | '_' | '\'' | '?' | '!' };
OPERATOR        = SYMBOL, { SYMBOL };
SYMBOL          = '+' | '-' | '*' | '/' | '=' | '<' | '>' | '≤' | '≥' | '≠'
                | '∧' | '∨' | '¬' | '→' | '←' | '⇒' | '⇐' | '↔'
                | '∑' | '∏' | '∫' | '∂' | '∇' | '√' | '∞'
                | '∘' | '⊗' | '⊕' | '†' | '‡' | '·' | '×' | '÷'
                | '↑' | '↓' | '⊤' | '⊥' | '│' | '‖' | '≡' | '≅' | '≈'
                | '⊂' | '⊃' | '⊆' | '⊇' | '∈' | '∉' | '∪' | '∩' | '∖'
                | '∀' | '∃' | '∄' | 'λ' | 'Λ' | 'Π' | 'Σ' | 'ℕ' | 'ℤ' | 'ℚ' | 'ℝ' | 'ℂ'
                | '𝕀' | '𝕆' ; (* Imaginary, Octonion *)

NUMERAL         = DIGIT, { DIGIT | '_' };
STRING_LIT      = '"', { CHAR - '"' - '\n' }, '"';
CHAR_LIT        = '\'', CHAR - '\'' - '\n', '\'';

KEYWORD         = 'theorem' | 'lemma' | 'proof' | 'qed' | 'by' | 'have' | 'show'
                | 'function' | 'def' | 'let' | 'in' | 'where' | 'if' | 'then' | 'else'
                | 'match' | 'with' | 'case' | 'of' | 'inductive' | 'structure' | 'class'
                | 'instance' | 'extend' | 'namespace' | 'open' | 'import' | 'export'
                | 'module' | 'kernel' | 'target' | 'vectorize' | 'verify' | 'pragma'
                | 'Int' | 'Nat' | 'Rational' | 'Algebraic' | 'Symbolic'
                | 'Tensor' | 'Matrix' | 'QuantumState' | 'Qubit' | 'Qureg'
                | 'H' | 'X' | 'Y' | 'Z' | 'CNOT' | 'CZ' | 'SWAP' | 'Toffoli'
                | 'measure' | 'reset' | 'entangle' | 'superpose'
                | 'C--' | 'LLVM' | 'MLIR' | 'PTX' | 'SPIRV' | 'Verilog' | 'Chisel'
                | 'AVX512' | 'NEON' | 'SVE' | 'AMX' | 'TPU' | 'FPGA'
                | 'overflow' | 'underflow' | 'precision' | 'alignment' | 'pipeline'
                | 'true' | 'false' | 'Type' | 'Prop' | 'Sort' | 'Kind'
                | 'Σ' | 'Π' | '∫' | '∂' | '∇' | '√' | '∞' | 'ℵ' | 'ℶ' ;

COMMENT         = '--', { CHAR - '\n' }, '\n'
                | '/-', { CHAR - '-/' }, '-/' ;

WHITESPACE      = ' ' | '\t' | '\n' | '\r' ;

(* ---------- Program ---------- *)
PROGRAM         = { DECLARATION } ;

DECLARATION     = THEOREM_DECL
                | FUNCTION_DECL
                | KERNEL_DECL
                | MODULE_DECL
                | IMPORT_DECL
                | NAMESPACE_DECL
                | INDUCTIVE_DECL
                | STRUCTURE_DECL
                | CLASS_DECL
                | INSTANCE_DECL ;

(* ---------- Module System ---------- *)
MODULE_DECL     = 'module', IDENTIFIER, '{', { DECLARATION }, '}' ;
IMPORT_DECL     = 'import', IDENTIFIER, { '.' , IDENTIFIER } ;
NAMESPACE_DECL  = 'namespace', IDENTIFIER, '{', { DECLARATION }, '}' ;
OPEN_DECL       = 'open', IDENTIFIER, { ',' , IDENTIFIER } ;

(* ---------- Types ---------- *)
TYPE            = BASE_TYPE
                | FUNCTION_TYPE
                | DEPENDENT_TYPE
                | REFINEMENT_TYPE
                | TENSOR_TYPE
                | MATRIX_TYPE
                | QUANTUM_TYPE
                | TYPE_APP
                | TYPE_VAR
                | '(' , TYPE , ')' ;

BASE_TYPE       = 'Int' | 'Nat' | 'Rational' | 'Algebraic' | 'Symbolic'
                | 'Bool' | 'String' | 'Unit' | 'Type' | 'Prop' | 'Sort' ;

FUNCTION_TYPE   = TYPE, '→', TYPE
                | '∀', BINDER, { ',' , BINDER }, '.', TYPE ;

DEPENDENT_TYPE  = 'Π', BINDER, { ',' , BINDER }, '.', TYPE
                | 'Σ', BINDER, { ',' , BINDER }, '.', TYPE ;

REFINEMENT_TYPE = '{', IDENTIFIER, ':', TYPE, '|', EXPR, '}' ;

TENSOR_TYPE     = 'Tensor', '[', TYPE, { ',' , TYPE }, ']', '{', SHAPE_SPEC, '}' ;
SHAPE_SPEC      = DIM_SPEC, { '×', DIM_SPEC } ;
DIM_SPEC        = NUMERAL | IDENTIFIER | '?' ; (* ? = dynamic *)

MATRIX_TYPE     = 'Matrix', '[', TYPE, ']', '{', DIM_SPEC, '×', DIM_SPEC, '}' ;

QUANTUM_TYPE    = 'QuantumState', '[', NUMERAL, ']'   (* n-qubit state *)
                | 'Qubit'
                | 'Qureg', '[', NUMERAL, ']' ;

TYPE_APP        = IDENTIFIER, '{', TYPE, { ',' , TYPE }, '}' ;
TYPE_VAR        = '?' , IDENTIFIER ; (* Metavariable *)

BINDER          = IDENTIFIER, ':', TYPE ;

(* ---------- Expressions ---------- *)
EXPR            = LAMBDA_EXPR
                | APPLICATION
                | INFIX_EXPR
                | PREFIX_EXPR
                | POSTFIX_EXPR
                | IF_THEN_ELSE
                | MATCH_EXPR
                | LET_EXPR
                | SIGMA_EXPR
                | PI_EXPR
                | INTEGRAL_EXPR
                | SET_COMPREHENSION
                | TUPLE
                | VECTOR_LIT
                | MATRIX_LIT
                | PAREN_EXPR
                | LITERAL
                | VARIABLE
                | OPERATOR_SECTION ;

LAMBDA_EXPR     = 'λ', BINDER, { ',' , BINDER }, '.', EXPR
                | 'fun', BINDER, { ',' , BINDER }, '=>', EXPR ;

APPLICATION     = EXPR, ' ', EXPR
                | EXPR, '(', ARG_LIST, ')' ;

INFIX_EXPR      = EXPR, OPERATOR, EXPR
                | EXPR, '∈', EXPR
                | EXPR, '∉', EXPR
                | EXPR, '⊂', EXPR
                | EXPR, '⊃', EXPR
                | EXPR, '⊆', EXPR
                | EXPR, '⊇', EXPR ;

PREFIX_EXPR     = OPERATOR, EXPR
                | '¬', EXPR
                | '∀', BINDER, '.', EXPR
                | '∃', BINDER, '.', EXPR
                | '∄', BINDER, '.', EXPR ;

POSTFIX_EXPR    = EXPR, '⁻¹'
                | EXPR, '†'
                | EXPR, '‡'
                | EXPR, '⊤'
                | EXPR, '⊥' ;

IF_THEN_ELSE    = 'if', EXPR, 'then', EXPR, 'else', EXPR ;

MATCH_EXPR      = 'match', EXPR, 'with', '{', MATCH_CASE, { MATCH_CASE }, '}' ;
MATCH_CASE      = PATTERN, '=>', EXPR ;

LET_EXPR        = 'let', BINDER, '=', EXPR, 'in', EXPR
                | 'let', IDENTIFIER, '=', EXPR, 'in', EXPR ;

SIGMA_EXPR      = 'Σ', '[', BINDER, '..', EXPR, ']', EXPR
                | '∑', BINDER, '∈', EXPR, ',', EXPR ;

PI_EXPR         = 'Π', '[', BINDER, '..', EXPR, ']', EXPR
                | '∏', BINDER, '∈', EXPR, ',', EXPR ;

INTEGRAL_EXPR   = '∫', '[', EXPR, '..', EXPR, ']', EXPR, 'd', IDENTIFIER ;

SET_COMPREHENSION = '{', EXPR, '|', BINDER, '∈', EXPR, ',', EXPR, '}' ;

TUPLE           = '(', EXPR, { ',' , EXPR }, ')' ;

VECTOR_LIT      = '[', EXPR, { ';' , EXPR }, ']' ;

MATRIX_LIT      = '[', ROW, { ';' , ROW }, ']' ;
ROW             = EXPR, { ',' , EXPR } ;

PAREN_EXPR      = '(', EXPR, ')' ;

LITERAL         = NUMERAL
                | STRING_LIT
                | CHAR_LIT
                | 'true' | 'false' ;

VARIABLE        = IDENTIFIER ;

OPERATOR_SECTION = '(', OPERATOR, ')'
                 | '(', EXPR, OPERATOR, ')'
                 | '(', OPERATOR, EXPR, ')' ;

PATTERN         = '_'
                | VARIABLE
                | LITERAL
                | CONSTRUCTOR_PATTERN
                | TUPLE_PATTERN
                | VECTOR_PATTERN
                | AS_PATTERN ;

CONSTRUCTOR_PATTERN = IDENTIFIER, [ PATTERN, { ',' , PATTERN } ] ;
TUPLE_PATTERN       = '(', PATTERN, { ',' , PATTERN }, ')' ;
VECTOR_PATTERN      = '[', PATTERN, { ';' , PATTERN }, ']' ;
AS_PATTERN          = VARIABLE, '@', PATTERN ;

ARG_LIST        = EXPR, { ',' , EXPR } ;

(* ---------- Theorem / Proof ---------- *)
THEOREM_DECL    = ( 'theorem' | 'lemma' ), IDENTIFIER, [ TYPE_PARAMS ], ':',
                  TYPE, [ ':=' , PROOF_TERM ] ;

TYPE_PARAMS     = '{', TYPE_VAR, { ',' , TYPE_VAR }, '}' ;

PROOF_TERM      = 'by', TACTIC_SEQUENCE
                | EXPR ;

TACTIC_SEQUENCE = TACTIC, { ';', TACTIC } ;
TACTIC          = 'intro' | 'apply' | 'rw' | 'simp' | 'norm_num' | 'linarith'
                | 'ring' | 'field' | 'induction' | 'cases' | 'constructor'
                | 'exact' | 'assumption' | 'tauto' | 'omega' | 'decide'
                | 'have', IDENTIFIER, ':', TYPE, ':=' , PROOF_TERM
                | 'calc', '{', CALC_STEP, { CALC_STEP }, '}' ;

CALC_STEP       = EXPR, REL_OP, EXPR, [ ':=' , PROOF_TERM ] ;
REL_OP          = '=' | '≤' | '<' | '≥' | '>' | '≡' | '≅' ;

(* ---------- Function Definition ---------- *)
FUNCTION_DECL   = 'function', IDENTIFIER, [ TYPE_PARAMS ], '(',
                  [ PARAM_LIST ], ')', [ ':', TYPE ], '=', EXPR ;

PARAM_LIST      = BINDER, { ',' , BINDER } ;

(* ---------- Kernel Definition ---------- *)
KERNEL_DECL     = 'kernel', IDENTIFIER, [ TYPE_PARAMS ], ':',
                  '{', KERNEL_SPEC, { ',' , KERNEL_SPEC }, '}' ;

KERNEL_SPEC     = 'target', '=', TARGET_SPEC
                | 'vectorize', '=', VECTORIZE_SPEC
                | 'verify', '=', VERIFY_SPEC
                | 'pragma', '=', STRING_LIT
                | 'layout', '=', LAYOUT_SPEC
                | 'precision', '=', PRECISION_SPEC ;

TARGET_SPEC     = 'C--' | 'LLVM' | 'MLIR' | 'PTX' | 'SPIRV' | 'Verilog' | 'Chisel' ;
VECTORIZE_SPEC  = 'AVX512' | 'NEON' | 'SVE' | 'AMX' | 'TPU' | 'FPGA' | 'auto' | 'none' ;
VERIFY_SPEC     = 'overflow', '=', BOOL
                | 'underflow', '=', BOOL
                | 'precision', '=', PRECISION_SPEC
                | 'alignment', '=', NUMERAL
                | 'pipeline', '=', NUMERAL
                | 'memory_safety', '=', BOOL
                | 'termination', '=', BOOL ;

LAYOUT_SPEC     = 'row_major' | 'col_major' | 'blocked', '{', NUMERAL, '×', NUMERAL, '}' ;
PRECISION_SPEC  = 'fp64' | 'fp32' | 'fp16' | 'bf16' | 'int64' | 'int32' | 'int16' | 'int8'
                | 'posits', '(', NUMERAL, ',', NUMERAL, ')' ;
BOOL            = 'true' | 'false' ;

(* ---------- Inductive / Structure / Class ---------- *)
INDUCTIVE_DECL  = 'inductive', IDENTIFIER, [ TYPE_PARAMS ], [ ':', TYPE ],
                  '{', { CONSTRUCTOR_DECL }, '}' ;

CONSTRUCTOR_DECL = IDENTIFIER, [ ':', TYPE ] ;

STRUCTURE_DECL  = 'structure', IDENTIFIER, [ TYPE_PARAMS ], [ ':', TYPE ],
                  '{', { FIELD_DECL }, '}' ;

FIELD_DECL      = IDENTIFIER, ':', TYPE ;

CLASS_DECL      = 'class', IDENTIFIER, [ TYPE_PARAMS ], [ ':', TYPE ],
                  '{', { METHOD_DECL }, '}' ;

METHOD_DECL     = IDENTIFIER, ':', TYPE ;

INSTANCE_DECL   = 'instance', [ IDENTIFIER, ':' ], TYPE, [ 'where', '{', { METHOD_IMPL }, '}' ] ;
METHOD_IMPL     = IDENTIFIER, '=', EXPR ;

(* ============================================================
   End of Grammar
   ============================================================ *)

(* ============================================================
   MATHLIB5 APL Kernel Targets — C-- / LLVM / MLIR / PTX / SPIR-V
   ============================================================ *)

(* ---------- Kernel Pragmas ---------- *)
(* #pragma target C--                -- Emit C-- intermediate representation
   #pragma target LLVM               -- Emit LLVM IR
   #pragma target MLIR               -- Emit MLIR dialect
   #pragma target PTX                -- Emit NVIDIA PTX assembly
   #pragma target SPIR-V             -- Emit SPIR-V binary
   #pragma target Verilog            -- Emit Verilog HDL
   #pragma target Chisel             -- Emit Chisel Scala

   #pragma vectorize AVX512          -- Intel AVX-512
   #pragma vectorize NEON            -- ARM NEON
   #pragma vectorize SVE             -- ARM SVE/SVE2
   #pragma vectorize AMX             -- Intel AMX
   #pragma vectorize TPU             -- Google TPU
   #pragma vectorize FPGA            -- FPGA HLS
   #pragma vectorize auto            -- Auto-detect
   #pragma vectorize none            -- Disable vectorization

   #pragma verify overflow=true      -- Insert overflow checks
   #pragma verify underflow=true     -- Insert underflow checks
   #pragma verify precision=fp64     -- Enforce fp64 precision
   #pragma verify alignment=64       -- 64-byte alignment
   #pragma verify pipeline=4         -- 4-stage pipeline
   #pragma verify memory_safety=true -- Insert bounds checks
   #pragma verify termination=true   -- Prove termination

   #pragma layout row_major          -- Row-major layout
   #pragma layout col_major          -- Column-major layout
   #pragma layout blocked {64×64}    -- 64×64 blocked layout

   #pragma precision fp64            -- IEEE 754 double
   #pragma precision fp32            -- IEEE 754 single
   #pragma precision fp16            -- IEEE 754 half
   #pragma precision bf16            -- Brain floating point
   #pragma precision int64           -- 64-bit integer
   #pragma precision int32           -- 32-bit integer
   #pragma precision int16           -- 16-bit integer
   #pragma precision int8            -- 8-bit integer
   #pragma precision posits(32,2)    -- Posit(32,2)

   #pragma layout row_major
   #pragma layout col_major
   #pragma layout blocked {64×64}

   #pragma precision fp64
   #pragma precision posits(32,2) *)

(* ============================================================
   MATHLIB5 Pipeline Stages
   ============================================================

   Stage 1: APL Surface Syntax     → Parser (EBNF above)
   Stage 2: Typed IR               → Typed Intermediate Representation
   Stage 3: C-- Kernel             → C-- FFI Kernel
   Stage 4: FOL Verification       → C99 Resolution Prover (15/15 theorems)
   Stage 5: CodeQL Meta-Validation → Datalog Rules
   Stage 6: ASP Stable Models      → Answer Set Programming
   Stage 7: Prolog Policies        → Solver Dispatch / Trust / Resources
   Stage 8: PRISM Skills           → Canonical JSON + WORM Sealing
   Stage 9: P/NP Swarm             → Multi-Agent Proof Search
   Stage 10: Receipt Chain         → WORM Ledger (SHA-256 + Merkle)

   ============================================================ *)

(* ============================================================
   MATHLIB5 Trust Model
   ============================================================

   Component              | Lines | Language | Verification
   ----------------------|-------|----------|---------------------------
   C99 Kernel            | ~500  | C99      | CIC, de Bruijn, arena
   AXIOM Kernel          | ~400  | Rust     | Type checker, beta reduction
   FOL Checker           | ~1500 | C99      | 15/15 theorems
   PRISM Seal            | ~300  | Rust     | SHA-256d, canonical JSON, WORM
   WORM Database         | ~200  | Rust     | Append-only, Merkle tree
   REXX Interpreter      | ~800  | Rust     | Stem vars, dynamic indices
   FOL Checker           | ~1500 | C99      | 15/15 theorems
   CodeQL Rules          | ~500  | Datalog  | Meta-validation
   ASP Rules             | ~400  | Prolog   | Stable models
   Prolog Policies       | ~200  | Prolog   | Solver dispatch/trust
   PRISM Skills          | ~300  | Rust     | Canonical JSON, WORM seal
   REXX Interpreter      | ~800  | Rust     | Stem vars, dynamic indices
   R Scripts             | 4 files| R       | Statistical analysis
   PowerShell            | 2 files| PS      | Business logic

   Ed25519: Plasma gate signing
   No Python. No Lean 4. Pure Rust + C99 + APL + Fortran + REXX + R + Prolog.

   ============================================================ *)

(* ============================================================
   MATHLIB5 Receipt Chain (WORM)
   ============================================================

   source.sha256 → binary.sha256 → manifest.json → seal.sha256

   Every proof is sealed to a WORM ledger with SHA-256 hashing
   and Merkle tree verification.

   ============================================================ *)

(* ============================================================
   Reproducible Builds
   ============================================================

   # Full pipeline
   cargo build --release
   cargo test
   cd layers/fol/src && gcc -O3 -o fol_check fol_resolution_checker.c && ./fol_check
   ./target/release/sorryhunter dashboard
   ./target/release/rexx-interp layers/scripting/rexx/classify_proof.rexx
   Rscript layers/scripting/r/convergence.R

   ============================================================ *)

