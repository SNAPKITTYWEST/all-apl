# MLIR dialect for verified kernels
filegroup(
    name = "mlir_dialect",
    srcs = glob(["mlir/**/*.td"]),
)

# LLVM IR emission from sexpr + verified kernels
haskell_library(
    name = "llvm_backend",
    srcs = glob(["src/**/*.hs"]),
    deps = [
        "//layers/sexpr:sexpr_ast",
        "@rules_llvm//llvm:ir",
        "@rules_llvm//llvm:execution_engine",
        "//runtime/kernels:verified_kernels",
    ],
)

# CompCert-verified subset for FFI shim
cc_library(
    name = "ffi_shim",
    srcs = ["src/ffi_shim.c"],
    hdrs = ["include/ffi_shim.h"],
    deps = ["@compcert//:clib"], # if CompCert in Bazel
)
