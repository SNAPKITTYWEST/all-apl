load("@rules_haskell//haskell:defs.bzl", "haskell_library", "haskell_test")

haskell_library(
    name = "mathlib5_parser",
    srcs = glob(["src/**/*.hs"]),
    deps = [
        "//layers/ir:typed_ir",
        "@hackage//:base",
        "@hackage//:megaparsec",
