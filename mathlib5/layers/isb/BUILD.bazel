# Chisel/Verilog emission from sexpr AST
haskell_library(
    name = "isb_lowering",
    srcs = glob(["src/**/*.hs"]),
    deps = [
        "//layers/sexpr:sexpr_ast",
        "@hackage//:clash-prelude", # or custom Verilog emitter
    ],
)

# Verilog → synthesis (Yosys + nextpnr) via Bazel genrule
genrule(
    name = "synth_example",
    srcs = [":isb_lowering"],
    outs = ["build/example.json"], # netlist
    cmd = "$(location //tools:yosys) -p 'read_verilog $<; synth_ice40 -top top -json $@'",
    tools = ["//tools:yosys"],
)
