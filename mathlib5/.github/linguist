# GitHub Linguist overrides for language detection
*.apl linguist-language=APL
*.axiom linguist-language=AXIOM
*.lean linguist-language=Lean
*.pl linguist-language=Prolog
*.f90 linguist-language=Fortran
*.R linguist-language=R
*.rexx linguist-language=REXX
*.ps1 linguist-language=PowerShell
*.sh linguist-language=Shell
*.bfn linguist-language=Brainfuck

# Exclude generated/build files from language stats
target/* linguist-vendored
*.lock linguist-vendored
*.rlib linguist-vendored
*.pdb linguist-vendored
*.dll linguist-vendored
*.exe linguist-vendored
*.dll.exp linguist-vendored
*.dll.lib linguist-vendored
*.lib linguist-vendored
*.d linguist-vendored

# Exclude Makefiles from language stats (build artifacts)
Makefile linguist-vendored
makefile linguist-vendored
*.mak linguist-vendored
*.mk linguist-vendored

# Documentation
*.md linguist-documentation
*.bnf linguist-documentation

# Bazel/Haskell files
*.bazel linguist-language=Starlark
BUILD.bazel linguist-language=Starlark
WORKSPACE.bazel linguist-language=Starlark
*.bzl linguist-language=Starlark

# Nix
*.nix linguist-language=Nix

# Lean 4
*.lean linguist-language=Lean

# Generated files
*.d linguist-vendored
*.rlib linguist-vendored
*.pdb linguist-vendored
*.dll linguist-vendored
*.exe linguist-vendored
*.dll.exp linguist-vendored
*.dll.lib linguist-vendored
*.lib linguist-vendored
*.dll.import linguist-vendored